#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// #include "maze.h"
#include "utils.h"

Maze *
create_maze (int rows, int cols)
{
  if (rows <= 0 || cols <= 0 || rows > MAX_SIZE || cols > MAX_SIZE)
    return NULL;

  Maze *maze = (Maze *)safe_malloc (sizeof (Maze));
  maze->rows = rows;
  maze->cols = cols;

  /* cols+1 wide to store right boundary wall, rows+1 tall for bottom boundary
   */
  maze->cells = (Cell **)create_2d_array (rows + 1, cols + 1, sizeof (Cell));

  /* zero-initialize all cells (rw=false, bw=false) */
  for (int i = 0; i <= rows; ++i)
    for (int j = 0; j <= cols; ++j)
      maze->cells[i][j] = (Cell){ false, false };

  /* boundary walls */
  for (int i = 0; i < rows; ++i)
    maze->cells[i][cols].rw = true; /* right boundary */
  for (int j = 0; j < cols; ++j)
    maze->cells[rows][j].bw = true; /* bottom boundary */

  return maze;
}

void
destroy_maze (Maze *maze)
{
  if (!maze)
    return;
  if (maze->cells)
    destroy_2d_array ((void **)maze->cells, maze->rows + 1);
  free (maze);
}

Maze *
load_maze_from_file (const char *filename)
{
  FILE *file = fopen (filename, "r");
  if (!file)
    return NULL;

  int rows, cols;
  if (fscanf (file, "%d %d", &rows, &cols) != 2)
    {
      fclose (file);
      return NULL;
    }

  Maze *maze = create_maze (rows, cols);
  if (!maze)
    {
      fclose (file);
      return NULL;
    }

  /* read vertical (right) walls */
  for (int i = 0; i < rows; ++i)
    {
      for (int j = 0; j < cols; ++j)
        {
          int w;
          if (fscanf (file, "%d", &w) != 1)
            {
              destroy_maze (maze);
              fclose (file);
              return NULL;
            }
          maze->cells[i][j].rw = (w != 0);
        }
    }

  /* read horizontal (bottom) walls */
  for (int i = 0; i < rows; ++i)
    {
      for (int j = 0; j < cols; ++j)
        {
          int w;
          if (fscanf (file, "%d", &w) != 1)
            {
              destroy_maze (maze);
              fclose (file);
              return NULL;
            }
          maze->cells[i][j].bw = (w != 0);
        }
    }

  fclose (file);
  return maze;
}

bool
save_maze_to_file (const Maze *maze, const char *filename)
{
  if (!maze || !filename)
    return false;

  FILE *file = fopen (filename, "w");
  if (!file)
    return false;

  fprintf (file, "%d %d\n", maze->rows, maze->cols);

  /* vertical walls */
  for (int i = 0; i < maze->rows; ++i)
    {
      for (int j = 0; j < maze->cols; ++j)
        fprintf (file, "%d ", maze->cells[i][j].rw ? 1 : 0);
      fprintf (file, "\n");
    }

  fprintf (file, "\n");

  /* horizontal walls */
  for (int i = 0; i < maze->rows; ++i)
    {
      for (int j = 0; j < maze->cols; ++j)
        fprintf (file, "%d ", maze->cells[i][j].bw ? 1 : 0);
      fprintf (file, "\n");
    }

  fclose (file);
  return true;
}

void
render_maze (const Maze *maze)
{
  if (!maze)
    return;

  printf ("+");
  for (int j = 0; j < maze->cols; ++j)
    printf ("---+");
  printf ("\n");

  for (int i = 0; i < maze->rows; ++i)
    {
      printf ("|");
      for (int j = 0; j < maze->cols; ++j)
        {
          printf ("   ");
          printf (maze->cells[i][j].rw ? "|" : " ");
        }
      printf ("\n+");
      for (int j = 0; j < maze->cols; ++j)
        printf (maze->cells[i][j].bw ? "---+" : "   +");
      printf ("\n");
    }
}

static int
assign_new_set (int set_members[], int n)
{
  for (int i = 1; i < n; ++i)
    {
      if (set_members[i] < 1) // if set is free assign to it
        {
          ++set_members[i];
          return i;
        }
    }
  return 0;
}

static int
reset_set (int set_members[], int old, int n)
{
  for (int i = 1; i < n; ++i)
    { // find occupied set
      if (old == i)
        {
          --set_members[i];
          break;
        }
    }
  return 0;
}

static void
merge_sets (int set_members[], int left, int *right, int n)
{
  if (!right || n < 2)
    return;

  if (*right != 0 && left != 0 && left != *right)
    {
      ++set_members[left], --set_members[*right];
      *right = left;
    }
}

Maze *
generate_perfect_maze (int rows, int cols)
{
  if (rows <= 0 || cols <= 0 || rows > MAX_SIZE || cols > MAX_SIZE)
    return NULL;

  Maze *maze = create_maze (rows, cols);
  if (!maze)
    return NULL;

  // this is for reusing set numbers. O(n) memory usage
  const int nset = cols + 1;
  int set_id[nset];
  memset (set_id, 0, sizeof (set_id));
  int set_members[nset];
  memset (set_members, 0, sizeof (set_members));
  bool has_opening[nset];
  memset (has_opening, false, sizeof (has_opening));

  for (int i = 0; i < rows; ++i)
    {
      /* copy horizontal walls from previous row */
      if (i > 0)
        { // don't need to do this for the 0th row
          for (int j = 0; j < cols; ++j)
            {
              if (maze->cells[i - 1][j].bw == true)
                { // reset set_membership of the cells that are cut off by
                  // upper (previous cell's bottom) wall
                  set_id[j] = reset_set (set_members, set_id[j], nset);
                }
            }
        }

      for (int j = 0; j < cols; ++j) // assign unique set to unassigned cells
        if (set_id[j] == 0)
          {
            set_id[j] = assign_new_set (set_members, nset);
          }

      /* vertical walls */
      if (i < rows - 1)
        { // (for all rows except the last)
          for (int j = 0; j < cols - 1; ++j)
            {
              if (set_id[j] == set_id[j + 1])
                {
                  maze->cells[i][j].rw = true;
                }
              else if (random_int (false, true) == true)
                {
                  maze->cells[i][j].rw = true;
                }
              else
                { // if random_int returned 'false' and cells are not from same
                  // set, then union the set_members
                  merge_sets (set_members, set_id[j], &set_id[j + 1], nset);
                }
            }
        }
      else
        { // for last row: just remove all right walls. this can be improved
          for (int j = 0; j < cols - 1; ++j)
            {
              if (set_id[j] != set_id[j + 1])
                {
                  maze->cells[i][j].rw = false;
                }
            }
        }
      maze->cells[i][cols - 1].rw = true; // right border

      /* horizontal walls */
      if (i < rows - 1)
        { // for all rows except the last
          for (int j = 0; j < cols; ++j)
            { // create bottom wall for every cell by default
              maze->cells[i][j].bw = true;
              memset (has_opening, false, sizeof (has_opening));
            }

          for (int j = 0; j < cols;
               ++j) // ensure at least one down passage per set
            if (!maze->cells[i][j].bw)
              has_opening[set_id[j]] = true;
          for (int j = 0; j < cols; ++j)
            if (!has_opening[set_id[j]])
              {
                maze->cells[i][j].bw = false;
                has_opening[set_id[j]] = true;
              }
        }
      else
        { // last row. just close all bottom walls
          for (int j = 0; j < cols; ++j)
            maze->cells[i][j].bw = true;
        }
    }

  return maze;
}
